node_modules/
dist/
*.log

# job history is runtime state, not source
.jobs/

# shortcut: `.env*` also hides a checked-in sample; force-add one with `git add -f`
.env*

# test artefacts
scripts/live-test-records.jsonl

# derived from session logs by `npm run training:data`; regenerate rather than commit
training-data.jsonl
